# Docker Compose 环境变量配置
# 复制此文件为 .env 并设置实际值
# 警告: .env 文件包含敏感信息，不要提交到 git

# PostgreSQL
POSTGRES_DB=talent_db
POSTGRES_USER=talent_user
# 必须修改！使用强密码（16位以上）
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis (生产环境必须设置)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Backend
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_SECRET_KEY
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=["http://localhost:2012"]
RATE_LIMIT_ENABLED=false

# LLM (可选)
LLM_ENABLED=false
LLM_API_KEY=your-llm-api-key

# GitHub (可选)
GITHUB_TOKENS=ghp_your_token

# Frontend
VITE_API_URL=http://localhost:8000
