# Application
APP_NAME=智能人才库 API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://talent_user:talent_password@localhost:5432/talent_db
DATABASE_SYNC_URL=postgresql://talent_user:talent_password@localhost:5432/talent_db

# OpenAlex API
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_EMAIL=your-email@example.com
OPENALEX_RATE_LIMIT=10

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# CORS (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Batch/Sync
BATCH_SIZE=1000
SYNC_TIMEOUT=3600
