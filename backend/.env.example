# ===========================================
# 智能人才库 API 配置文件示例
# 版本: 1.4.1
# ===========================================

# ========== 应用基础 ==========
APP_NAME=智能人才库 API
APP_VERSION=1.4.1
DEBUG=false
ENVIRONMENT=development

# ========== 数据库 ==========
DATABASE_URL=postgresql+asyncpg://talent_user:ai4recruit@localhost:5432/talent_db
DATABASE_SYNC_URL=postgresql://talent_user:ai4recruit@localhost:5432/talent_db

# ========== OpenAlex API ==========
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_EMAIL=your-email@example.com
OPENALEX_RATE_LIMIT=10

# ========== JWT 认证 ==========
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# ========== CORS ==========
# 开发环境允许所有来源，生产环境建议限制
CORS_ORIGINS=["*"]

# ========== 分页 ==========
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ========== 批量处理 ==========
BATCH_SIZE=1000
SYNC_TIMEOUT=3600

# ========== Redis 缓存 (v1.3+) ==========
# Redis 用于首页缓存和搜索缓存，可大幅提升性能
# 开发环境可禁用，生产环境建议启用
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10
CACHE_DEFAULT_TTL=300
CACHE_KEY_PREFIX=ai4talents

# ========== LLM 配置 (v1.4+) ==========
# LLM 用于语义搜索和 JD 岗位匹配
# 支持: deepseek, openai, zhipu, qwen, custom
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_EMBEDDING_MODEL=deepseek-embedding
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=3
LLM_ENABLE_FALLBACK=false

# ========== Embedding 配置 (v1.4+) ==========
# 向量维度，取决于嵌入模型
# deepseek-embedding: 1536, openai text-embedding-3-small: 1536
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100

# ========== 搜索配置 (v1.4+) ==========
# 默认搜索模式: keyword, fulltext, semantic, hybrid
SEARCH_DEFAULT_MODE=keyword
SEARCH_ENABLE_SEMANTIC=true

# 搜索阈值
SEARCH_SEMANTIC_THRESHOLD=0.7
SEARCH_PRECISE_THRESHOLD=0.95
SEARCH_SIMILAR_THRESHOLD_MIN=0.7

# 混合搜索参数
SEARCH_RRF_CONSTANT=60
SEARCH_HYBRID_EXTENDED_FACTOR=3

# ========== 推荐配置 (v1.4+) ==========
RECOMMEND_SIMILARITY_THRESHOLD=0.6
RECOMMEND_TAG_WEIGHT=0.5
RECOMMEND_RESEARCH_WEIGHT=0.5

# ========== JD 匹配权重 (v1.4.1) ==========
JD_MATCH_WEIGHT_RESEARCH=1.0

# ========== 限流配置 ==========
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100
